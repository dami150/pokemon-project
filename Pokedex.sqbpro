VALUES (&quot;Shell Armor&quot;, &quot;A hard shell protects the Pokémon from critical hits.&quot;),
(&quot;Levitate&quot;, &quot;By floating in the air, the Pokémon receives full immunity to all Ground-type moves.&quot;),
(&quot;Cursed Body&quot;, &quot;May disable a move that has dealt damage to the Pokémon.&quot;),
(&quot;Insomnia&quot;, &quot;The Pokémon’s insomnia prevents it from falling asleep.&quot;),
(&quot;Forewarn&quot;, &quot;When it enters a battle, the Pokémon can tell one of the moves an opposing Pokémon has.&quot;),
(&quot;Hyper Cutter&quot;, &quot;The Pokémon’s prized, mighty pincers prevent other Pokémon from lowering its Attack stat.&quot;),
(&quot;Soundproof&quot;, &quot;Soundproofing gives the Pokémon full immunity to all sound-based moves.&quot;),
(&quot;Lightning Rod&quot;, &quot;The Pokémon draws in all Electric-type moves. Instead of taking damage from them, its Sp. Atk stat is boosted.&quot;),
(&quot;Reckless&quot;, &quot;Powers up moves that have recoil damage.&quot;);

SELECT * FROM Abilities
ORDER BY AbilitiesName;</sql><current_tab id="0"/></tab_sql></sqlb_project>
